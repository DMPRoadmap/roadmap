<% title sanitize(_("%{plan_title} - research outputs") % {plan_title: @plan.title}) %>



<div class="row">
  <div class="col-md-12">
    <!-- render the project title -->
    <h1><%= sanitize(@plan.title) %></h1>
  </div>
</div>

<% content_for :plan_tab_body do %>
  <div class="row">
    <div class="col-md-12">
      <p>
        <%= _("Please list your anticipated research output(s).") %>
      </p>
      <br/>

      <% if @research_outputs.any? %>
        <%= paginable_renderise partial: "/paginable/research_outputs/index",
                                controller: "paginable/research_outputs",
                                action: "index",
                                scope: @research_outputs,
                                locals: { plan: @plan },
                                query_params: {
                                  sort_field: 'research_outputs.title',
                                  sort_direction: :asc } %>
      <% end %>

      <% if @plan.administerable_by?(current_user.id) %>
        <div class="mb-3">
          <%= link_to _("Add a research output"), new_plan_research_output_path(@plan),
                                              class: "btn btn-primary" %>
          <% if ExternalApis::DoiResolutionService.active? %>
            <button id="btn_toggle_doi_form" type="button" class="btn btn-secondary">
                <%= _("Add from DOI") %>
            </button>
          <% end %>
        </div>

        <% if ExternalApis::DoiResolutionService.active? %>
          <div id="doi_lookup_panel" class="card d-none my-3">
            <div class="card-body">
              <div class="mb-0">
                <label for="doi_lookup_input" class="form-label fw-bold">
                  <%= _("Pre-fill with DOI") %>
                </label>
                <p class="form-label mt-0 mb-2">
                  <%= _("Enter a DOI (e.g., 10.5281/zenodo.4884775) to automatically import its metadata into a new form.") %>
                </p>
                
                <div class="input-group">
                  <input type="text" 
                         id="doi_lookup_input" 
                         class="form-control" 
                         placeholder="10.xxxx/xxxxxx">
                  <button id="btn_fetch_doi" 
                          class="btn" 
                          type="button"
                          data-new-research-output-path="<%= new_plan_research_output_path(@plan) %>">
                    <%= _("Fetch & Add") %>
                  </button>
                </div>
                
                <span id="doi_lookup_status" class="form-text d-none mt-2 mb-0"></span>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<%= render partial: "plans/navigation", locals: { plan: @plan } %>
